---
import { shows } from "../data/shows";
import "../styles/global.css";

const [featuredShow, ...archiveShows] = shows;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Zaina Radio is an independent radio from Dongguan, documenting broken rhythms, tribal percussion, bass culture, and underground electronic sounds."
    />

    <title>Zaina Radio — Independent Radio from Dongguan</title>
  </head>

  <body>
    <header class="site-header">
      <h1>
        <a href="#home">Zaina Radio</a>
      </h1>

      <nav aria-label="Main navigation">
        <a href="#home">Home</a>
        <a href="#shows">Shows</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main class="site-main">
      <section id="home" class="hero">
        <p class="eyebrow">Independent Radio from Dongguan</p>

        <h2>
          记录 broken rhythms、tribal percussion 与地下电子声音的独立电台。<br />
          让本地认识本地，让你们认识我们。
        </h2>

        {
          featuredShow && (
            <a class="button" href={`#${featuredShow.slug}`}>
              Listen to latest show
            </a>
          )
        }
      </section>

      {
        featuredShow && (
          <section id={featuredShow.slug} class="featured-show">
            <header class="section-heading">
              <p class="eyebrow">Featured Show</p>
              <p class="show-number">{featuredShow.number}</p>
              <h2>{featuredShow.title}</h2>
            </header>

            <div class="featured-grid">
              <img
                class="show-cover"
                src={`/images/shows/${featuredShow.coverFileName}`}
                alt={`${featuredShow.title} cover`}
                width="600"
                height="600"
              />

              <div class="show-details">
                <dl class="show-meta">
                  <div>
                    <dt>DJ / Selector</dt>
                    <dd>{featuredShow.dj}</dd>
                  </div>
                  <div>
                    <dt>Date</dt>
                    <dd><time datetime={featuredShow.date}>{featuredShow.date}</time></dd>
                  </div>
                  <div>
                    <dt>Duration</dt>
                    <dd>{featuredShow.duration}</dd>
                  </div>
                </dl>

                <p class="show-description">{featuredShow.description}</p>

                <ul class="tag-list" aria-label={`${featuredShow.title} tags`}>
                  {featuredShow.tags.map((tag) => <li>{tag}</li>)}
                </ul>

                <audio controls preload="none" src={featuredShow.audioUrl}>
                  你的浏览器不支持音频播放。
                </audio>
              </div>
            </div>
          </section>
        )
      }

      <section id="shows" class="shows-section">
        <header class="section-heading">
          <p class="eyebrow">Radio Archive</p>
          <h2>Shows</h2>
        </header>

        <div class="shows-grid">
          {
            archiveShows.map((show) => (
            <article id={show.slug} class="show-card">
              <img
                class="show-cover"
                src={`/images/shows/${show.coverFileName}`}
                alt={`${show.title} cover`}
                width="400"
                height="400"
                loading="lazy"
              />

              <div class="show-card__body">
                <p class="show-number">{show.number}</p>
                <h3>{show.title}</h3>

                <dl class="show-meta">
                  <div><dt>DJ</dt><dd>{show.dj}</dd></div>
                  <div><dt>Date</dt><dd><time datetime={show.date}>{show.date}</time></dd></div>
                  <div><dt>Duration</dt><dd>{show.duration}</dd></div>
                </dl>

                <p class="show-description">{show.description}</p>

                <ul class="tag-list" aria-label={`${show.title} tags`}>
                  {show.tags.map((tag) => <li>{tag}</li>)}
                </ul>

                <audio controls preload="none" src={show.audioUrl}>
                  你的浏览器不支持音频播放。
                </audio>
              </div>
            </article>
            ))
          }
        </div>
      </section>

      <section id="about" class="text-section">
        <header class="section-heading">
          <p class="eyebrow">Who We Are</p>
          <h2>About</h2>
        </header>

        <p>
          Zaina Radio 是一个关注电子音乐与地下文化的独立电台。源于东莞本地俱乐部场景，
          我们探索 leftfield 声音、broken rhythms、tribal percussion、bass
          文化以及不同风格之间的边界。我们希望让本地认识本地，也让更多人认识我们正在发生的声音。
          不依赖算法推荐，而是通过人工筛选、持续聆听与场景连接，记录那些值得被发现的音乐与文化。
        </p>

        <p lang="en">
          <small>
            Zaina Radio is an independent platform for electronic music and
            underground culture. From Dongguan’s local club scene, we explore
            leftfield sounds, broken rhythms, tribal percussion, bass-driven
            movements, and the spaces between genres. Our approach is simple:
            to let the local discover the local, and to share our sounds beyond
            familiar circles. Built around curiosity rather than algorithms,
            we focus on careful selection, long-form listening, and the scenes
            that shape the music.
          </small>
        </p>
      </section>

      <section id="contact" class="text-section contact-section">
        <header class="section-heading">
          <p class="eyebrow">Get in Touch</p>
          <h2>Contact</h2>
        </header>

        <address>
          <p>
            Email:
            <a href="mailto:hello@zainaradio.com">
              hello@zainaradio.com
            </a>
          </p>

          <p>
            Instagram:
            <a href="#" aria-label="Zaina Radio on Instagram">
              @zainaradio
            </a>
          </p>

          <p>
            SoundCloud:
            <a href="#" aria-label="Zaina Radio on SoundCloud">
              Zaina Radio
            </a>
          </p>
        </address>
      </section>
    </main>

    <footer class="site-footer">
      <p>© 2026 Zaina Radio. Independent and self-operated.</p>
    </footer>
  </body>
</html>
